# ============================================================
#  Educa360 Frontend - Plantilla de variables de entorno
# ------------------------------------------------------------
#  Copia este archivo a .env y ajusta los valores.
#  .env NO se versiona (está en .gitignore).
# ============================================================

# URL base de la API del backend (SIN /v1: el cliente lo agrega).
VITE_API_URL=http://localhost:8080/api

# URL del broker STOMP para notificaciones en tiempo real.
# Opcional: si no se define, el panel funciona sin tiempo real.
VITE_WS_URL=http://localhost:8080/ws
